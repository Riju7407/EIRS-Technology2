{
  "name": "eirs-technology",
  "version": "1.0.0",
  "description": "EIRS Technology - Integrated Security & Automation Solutions",
  "main": "api/index.js",
  "scripts": {
    "build": "npm --prefix client install --include=dev --no-audit --no-fund && npm --prefix client run build",
    "start": "node api/index.js",
    "start:dev": "NODE_OPTIONS=--no-deprecation node server/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && NODE_OPTIONS=--no-deprecation npm start",
    "client": "cd client && npm start",
    "install-all": "npm install && cd client && npm install && cd ../server && npm install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "20",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^1.41.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "email-validation": "^0.1.2",
    "express": "^5.2.1",
    "firebase": "^12.9.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^6.9.7",
    "razorpay": "^2.9.6",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-phone-input-2": "^2.15.1",
    "react-phone-number-input": "^3.4.14",
    "scheduler": "0.27.0",
    "twilio": "^5.12.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
